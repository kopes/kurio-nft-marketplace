# true: API REST e Socket.IO simulados com MSW (padrão). false: usa VITE_API_BASE_URL/VITE_REALTIME_URL reais.
VITE_ENABLE_MOCKS=true
# Base da API REST (relativa ou absoluta)
VITE_API_BASE_URL=/api
# Endpoint Socket.IO (com mocks, é interceptado pelo MSW; não há servidor real)
VITE_REALTIME_URL=wss://realtime.kurio.local
